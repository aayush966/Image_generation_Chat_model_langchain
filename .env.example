# Get a token at https://huggingface.co/settings/tokens (a free "read" token works)
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Open-source text-to-image model (open weights, served by the HF Inference API)
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# Alternatives:
#   stabilityai/stable-diffusion-xl-base-1.0
#   stabilityai/stable-diffusion-3.5-large-turbo
#   black-forest-labs/FLUX.1-dev

# Open-source chat model used by LangChain for routing + prompt enhancement
TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# "auto"  = Inference API when a token is set, otherwise the public Space (default)
# "api"   = Hugging Face Inference API (needs a token; falls back to the Space on failure)
# "space" = public Hugging Face Space - real images, NO token needed, but the free
#           anonymous quota is only a few images per hour (a token raises it a lot)
# "local" = run diffusers on this machine
# "demo"  = no model at all, draws a placeholder (for testing the UI offline)
BACKEND=auto

# Where generated images are written
OUTPUT_DIR=generated
