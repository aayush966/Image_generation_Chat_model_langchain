# Get a token at https://huggingface.co/settings/tokens (a free "read" token works)
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Vertex AI (paid, most accurate). Path to a service-account JSON key whose
# account has the "Vertex AI User" role, with the Vertex AI API enabled. Never commit it.
GOOGLE_APPLICATION_CREDENTIALS=key.json
# Optional: defaults to the key's project_id / these regions.
# GCP_PROJECT=my-project
# GCP_IMAGE_LOCATION=global
# GCP_VIDEO_LOCATION=us-central1

# Text-to-image model. With a Google key, the default is:
#   gemini-3.1-flash-image   Nano Banana 2, very accurate, ~10 s   (Google)
#   gemini-3-pro-image       Nano Banana Pro, most accurate, ~50 s (Google)
# Without one, the default is Z-Image-Turbo (open, top-tier, free public Space).
IMAGE_MODEL=gemini-3.1-flash-image
# Alternatives (* = also has a free public Space):
#   krea/Krea-2-Turbo *                 newest (Jun 2026), photographic
#   black-forest-labs/FLUX.2-klein-4B * FLUX.2 distilled, 4 steps, ~10 s
#   Qwen/Qwen-Image-2512                best for text in images, API only
#   tencent/HunyuanImage-3.0            80B, API only
#   black-forest-labs/FLUX.1-dev        API only
#   black-forest-labs/FLUX.1-schnell *  old default, fast but less accurate

# Text-to-video model. With a Google key, the default is Veo 3.1 (with sound):
#   veo-3.1-fast-generate-001   ~40 s per 4 s clip           (Google)
#   veo-3.1-generate-001        full quality, slower, pricier (Google)
#   veo-3.1-lite-generate-001   cheapest                      (Google)
# Without one, the default is MiniMax-H3, the top open video model (free Spaces).
VIDEO_MODEL=veo-3.1-fast-generate-001
# Open alternatives (* = also has a free public Space):
#   MiniMaxAI/MiniMax-H3 *
#   Wan-AI/Wan2.2-T2V-A14B                 API only
#   tencent/HunyuanVideo-1.5               API only
#   Lightricks/LTX-Video-0.9.7-distilled * fast, lower quality
# Default clip length in seconds (1 - 10; MiniMax needs at least 2). Longer = slower.
VIDEO_DURATION=4

# Open-source chat model used by LangChain for routing + prompt enhancement
TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct

# "auto"  = Inference API when a token is set, otherwise the public Space (default)
# "api"   = Hugging Face Inference API (needs a token; falls back to the Space on failure)
# "space" = public Hugging Face Space - real images, NO token needed, but the free
#           anonymous quota is only a few images per hour (a token raises it a lot)
# "local" = run diffusers on this machine
# "demo"  = no model at all, draws a placeholder (for testing the UI offline)
BACKEND=auto

# Where generated images are written
OUTPUT_DIR=generated
